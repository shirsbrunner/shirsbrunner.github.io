{# this is the tools-preview as shown on the toolslist #}

  <article class="tool_preview card_back">
    {# This could be some glyph or image - if we feel like doing this 
    <div class="small_preview_image" aria-hidden="true">
      {% if post.data.previewImage %} 
        <img src={{post.data.urlbase}}{{ post.data.previewImage }} alt="">
      {% else %}
        <img src="/images/structural/Placeholder-Image.png" alt="">
      {% endif %}
    </div>
    #}
    <div class="preview_content">
      <h2>
        {# this adds the title-link - the link to the webapp in this case #}    
      <a href="{{ post.data.urlbase }}" class="breakout-link">{{ post.data.title }}</a></h2>

      <div class="tag_group">
        <p class ="time">
        {% if post.data.date %}<time datetime="{{ post.data.date | dateymd }}">{{ post.data.date | datefriendly }}</time>{% endif %}
        {% if post.data.updateDate %} and updated on: <time datetime="{{ post.data.updateDate | dateymd }}">{{ post.data.updateDate | datefriendly }}</time>{% endif %}
      </div>
      <p>{{ post.data.description }}</p>
    </div>


  </article>