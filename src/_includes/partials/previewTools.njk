{# this is the tools-preview as shown on the toolslist #}

  <article class="tool_preview card_back">
    {# This could be some glyph or image - if we feel like doing this 
    <div class="small_preview_image" aria-hidden="true">
      {% if post.data.previewImage %} 
        <img src={{post.data.urlbase}}{{ post.data.previewImage }} alt="">
      {% else %}
        <img src="/images/structural/Placeholder-Image.png" alt="">
      {% endif %}
    </div>
    #}
    <div class="preview_content flex_gap_link">
      <div>
        <h2>
          {# this adds the title-link - the link to the webapp in this case #}    
          {{ post.data.title }}
        </h2>

        <div>
          <p class ="time">
          {% if post.data.date %}Published: <time datetime="{{ post.data.date | dateymd }}">{{ post.data.date | datefriendly }}</time>{% endif %} </p>
          <p class ="time">
          {% if post.data.updateDate %} Updated: <time datetime="{{ post.data.updateDate | dateymd }}">{{ post.data.updateDate | datefriendly }}</time>{% endif %}
        </div>
        <p>{{ post.data.description }}</p>
      </div>
      <div>
        <span aria-hidden: "true" class="headericon" data-icon="
          {# this adds the icon #}
          {{ post.data.icon}}
          ">
      </span>
      <a href="{{ post.data.urlbase }}" aria-label="start {{ post.data.title }}"class="breakout-link">Start webapp</a>
      </div>
    </div>


  </article>
